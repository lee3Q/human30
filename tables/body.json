          "type": "normal",
          "M": { "mean": 24.1, "sd": 3.2, "clip": [16, 35] },
          "F": { "mean": 22.3, "sd": 3.5, "clip": [15, 35] },
          "source": "KNHANES 20대"
        },
        "muscle_mass": {
          "type": "ordinal",
          "levels": ["빈약", "평균 이하", "평균", "평균 이상", "단련됨"],
          "weights_M": [0.15, 0.25, 0.35, 0.15, 0.10],
          "weights_F": [0.25, 0.30, 0.30, 0.10, 0.05]
        },
        "grip_strength_kg": {
          "type": "normal",
          "M": { "mean": 42, "sd": 8, "clip": [20, 65] },
          "F": { "mean": 25, "sd": 6, "clip": [12, 45] },
          "note": "근육량과 상관 0.6"
        },
        "whr_female": {
          "type": "normal",
          "mean": 0.76,
          "sd": 0.05,
          "clip": [0.65, 0.95],
          "note": "허리-엉덩이 비율. 짝짓기 시각 단서"
        },
        "shr_male": {
          "type": "normal",
          "mean": 1.35,
          "sd": 0.1,
          "clip": [1.1, 1.65],
          "note": "어깨-엉덩이 비율. 남성 짝짓기 성공 최강 신체 예측자 (근육과 동등)"
        },
        "waist_cm": {
          "type": "normal",
          "M": { "mean": 80, "sd": 8, "clip": [60, 110] },
          "F": { "mean": 70, "sd": 7, "clip": [55, 95] },
          "source": "KNHANES 20대 허리둘레",
          "note": "코어 근력 + 여성 몸매 의식 변수. 복부비만 cutoff M≥90 / F≥85."
        }
      },
      "source": "KNHANES + Gemini WHR/SHR 연구",
      "effect_size": "체중 낙인-정신건강 r=-0.35, 고용 OR 1.3~2.0 (여성↑)",
      "behavioral_note": "BMI 자체보다 *낙인·차별 경험*이 행동 예측. 여성 비만에 고용·임금 페널티 특히 큼.",
      "korea_amplified": true
    },

