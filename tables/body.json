{
  "layer": "body",
  "version": "0.1",
  "description": "신체 층 옵션 표. 20세 한국 성인 기준. 생성 시 1회 굴림 후 거의 고정. 분포는 KNHANES·KOSIS·임상 추정·디자인 기반. source 필드가 출처 투명성 제공.",

  "tables": {

    "B1_height": {
      "label": "키 (신장)",
      "scale": "continuous",
      "unit": "cm",
      "distributions": {
        "M": { "type": "normal", "mean": 173.7, "sd": 5.7, "clip": [150, 195] },
        "F": { "type": "normal", "mean": 160.9, "sd": 5.3, "clip": [140, 180] }
      },
      "source": "KNHANES 2020-2023 (20대 한국 성인)",
      "effect_size": "ρ=0.41 사회 존경, β=0.26 소득 (Judge & Cable 2004)",
      "behavioral_note": "남성에서 특히 지위·수입·리더십 예측. 여성은 파트너 선택 가중치. 키 불만족은 체계적 외로움·사회 철수 직접 예측자.",
      "korea_amplified": true
    },

    "B2_face_attractiveness": {
      "label": "얼굴 매력도",
      "scale": "ordinal_with_rank",
      "description": "1~10 절대 점수 + 30인 내 성별 서열 (남 15명·여 15명 각각 1~15위)",
      "distributions": {
        "absolute_score": { "type": "normal", "mean": 5, "sd": 1.8, "clip": [1, 10] },
        "sex_rank": "post-hoc computed from absolute_score within sex group"
      },
      "source": "디자인 추정. 사회적 매력도는 객관 측정 불가 but '관찰자 간 일치도 높음' (Langlois 2000)",
      "effect_size": "d=0.20~0.37 (행동·직업), 평생 수입 +10~15% (Hamermesh)",
      "behavioral_note": "초기 사회 평가, 대우 차이, 고용, 결혼 시장. 한국에서 증폭 (OR 3.70 반복 차별→건강 악화, Yoon 2017).",
      "korea_amplified": true,
      "interacts": ["B3_body_composition", "B4_face_features", "K2_korea_appearance_experience"]
    },

    "B3_body_composition": {
      "label": "체성분 (BMI, 근육, 악력, WHR/SHR)",
      "scale": "composite",
      "fields": {
